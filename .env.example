# OpenAI-compatible llama.cpp server (scripts/start_llama.sh)
SLM_WIKI_LLM_BASE_URL=http://127.0.0.1:18434/v1
SLM_WIKI_LLM_MODEL=Qwen_Qwen3-8B-Q4_K_M
SLM_WIKI_LLM_API_KEY=no-key
SLM_WIKI_LLM_TIMEOUT_S=600

# Or use MGA (OpenAI-compatible) instead of the local server
# SLM_WIKI_LLM_PROVIDER=mga
# SLM_WIKI_MGA_BASE_URL=https://...
# SLM_WIKI_MGA_API_KEY=mga-...
# SLM_WIKI_MGA_MODEL=claude-sonnet-4.6

# Set to false to hide MGA from the UI and block switching to it (default: true)
# SLM_WIKI_MGA_ENABLED=true

# Vault (raw + wiki + schema), relative to repo root
SLM_WIKI_VAULT=vault

# Tuning for small models
# SLM_WIKI_CHUNK_CHARS=4000
# SLM_WIKI_MAX_PAGES_PER_INGEST=20
# SLM_WIKI_QUERY_TOP_K=8
